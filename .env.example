# =============================================================================
# Parallax — Solana Tokenized Stock Arbitrage Bot
# =============================================================================
# Copy this file to .env and fill in your values.
# Lines starting with # are comments. Uncomment to enable.
#
# SAFETY: Default configuration is PAPER MODE — no real trades.
# You must explicitly enable live trading (see below).
# =============================================================================


# =============================================================================
# TRADING MODE
# =============================================================================

# Trading mode: paper (simulated), shadow (paper + real quotes), live (real trades)
# IMPORTANT: Default is 'paper' — safe mode with no real execution
TRADING_MODE=paper

# CRITICAL: Live trading safety gate
# Even if TRADING_MODE=live, trades won't execute unless this is 'true'
# This is a second safety layer — belt AND suspenders
LIVE_TRADING=false

# Dashboard admin password (protects kill switch and admin endpoints)
ADMIN_TOKEN=your_admin_password_here


# =============================================================================
# SOLANA WALLET
# =============================================================================

# Base58-encoded private key for the trading wallet
# WARNING: Use a DEDICATED hot wallet with ONLY trading capital
# NEVER use your main wallet or one with significant holdings
# Only required for live trading
SOLANA_PRIVATE_KEY=your_base58_private_key_here


# =============================================================================
# SOLANA RPC
# =============================================================================

# Primary RPC endpoint (Helius, QuickNode, or other provider recommended)
RPC_ENDPOINT=https://api.mainnet-beta.solana.com

# Fallback RPC endpoint (optional, for redundancy)
# RPC_ENDPOINT_2=https://your-backup-rpc.com


# =============================================================================
# DATABASE
# =============================================================================

# Supabase PostgreSQL — used for production data (positions, trades, heatmap)
# Get connection strings from: https://supabase.com → Project Settings → Database
TRADES_DB_URL=postgresql://postgres.xxxxx:your_password@aws-0-us-west-2.pooler.supabase.com:5432/postgres

# Direct connection (bypasses PgBouncer, needed for migrations)
DIRECT_URL=postgresql://postgres.xxxxx:your_password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# PgBouncer connection (optional, for connection pooling)
# DATABASE_URL=postgres://postgres.xxxxx:your_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true


# =============================================================================
# STOCK PRICE APIs (at least one recommended)
# =============================================================================

# Alpaca (recommended — free, fast batch queries, 200 req/min)
# Get keys from: https://alpaca.markets
ALPACA_KEY_ID=your_alpaca_key_id
ALPACA_SECRET_KEY=your_alpaca_secret_key

# Finnhub (60 req/min per key — multiple keys for higher throughput)
# Get keys from: https://finnhub.io
FINNHUB_API_KEY=your_finnhub_api_key
# FINNHUB_API_KEY_2=your_second_finnhub_key
# FINNHUB_API_KEY_3=your_third_finnhub_key

# Polygon.io
# Get keys from: https://polygon.io
POLYGON_API_KEY=your_polygon_api_key

# Alpha Vantage (backup)
# Get keys from: https://www.alphavantage.co
# ALPHA_VANTAGE_API_KEY=your_alphavantage_key

# Twelve Data — used for ATR (Average True Range) volatility calculation
# Enables per-token volatility-adjusted entry thresholds
# Get keys from: https://twelvedata.com
TWELVE_DATA_API_KEY=your_twelve_data_key


# =============================================================================
# DEX / JUPITER
# =============================================================================

# Jupiter API key (optional — higher rate limits for swaps)
# Get from: https://portal.jup.ag
# JUPITER_API_KEY=your_jupiter_api_key


# =============================================================================
# FLASH TRADE (Perps — for premium shorting)
# =============================================================================

# Enable shorting rStocks via Flash Trade perpetuals
# When tokens trade at a PREMIUM to NAV, Parallax can short via perps
ENABLE_SHORTING=false


# =============================================================================
# DASHBOARD
# =============================================================================

# Enable the web dashboard (discount heatmap, P&L, positions)
DASHBOARD_ENABLED=true

# Port for the dashboard web server
WEB_PORT=3001


# =============================================================================
# NOTIFICATIONS
# =============================================================================

# Discord webhook URL for trade notifications (entries, exits, alerts)
# Create a webhook in your Discord server: Server Settings → Integrations → Webhooks
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token


# =============================================================================
# TWITTER / X (Optional — automated posting)
# =============================================================================

# Twitter API v2 credentials for @para11ax bot
# Get from: https://developer.twitter.com
# TWITTER_API_KEY=your_api_key
# TWITTER_API_SECRET=your_api_secret
# TWITTER_BEARER_TOKEN=your_bearer_token
# TWITTER_ACCESS_TOKEN=your_access_token
# TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret
# TWITTER_CLIENT_ID=your_client_id
# TWITTER_CLIENT_SECRET=your_client_secret


# =============================================================================
# LOGGING
# =============================================================================

# Log levels: trace, debug, info, warn, error, fatal
LOG_LEVEL=info
LOG_LEVEL_CONSOLE=warn
LOG_LEVEL_FILE=debug


# =============================================================================
# GITHUB (Optional)
# =============================================================================

# GitHub token — used for automated changelog generation
# GITHUB_TOKEN=ghp_your_token_here


# =============================================================================
# HELIUS (Optional)
# =============================================================================

# Helius API key — if using Helius as your RPC provider, this is embedded
# in the RPC_ENDPOINT URL. Separate key for other Helius API features.
# HELIUS_API_KEY=your_helius_api_key
